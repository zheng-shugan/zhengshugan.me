---
import { SITE } from "@config";
import Layout from "@layouts/Layout.astro";
import {
  formatDate,
  getPostDate,
  getPosts,
  getPostUrlSlug,
  getSortedPostsByYear,
  getTags,
  slugifyTag
} from "@utils";
import { getCoverUrl } from "@utils/cover";
import { getPostExcerpt } from "@utils/excerpt";

export interface Props {
  activePage?: "home" | "posts";
}

const { activePage = "posts" } = Astro.props;
const posts = await getPosts("zh");
const sortedPostsByYear = getSortedPostsByYear(posts);
const { tags, numPostsPerTag } = getTags(posts);
---

<Layout title={`博客 - ${SITE.title}`} activePage={activePage} lang="zh">
  <div class="prose prose-lg m-auto">
    <h1>博客</h1>
    <div class="mt-4">
      {
        tags.map((tag) => (
          <span class="mr-1.5">
            <a href={`/posts/zh/tags/${slugifyTag(tag)}`} class="!text-c-light">
              {tag}
            </a>
            <sup>{numPostsPerTag[tag]}</sup>
          </span>
        ))
      }
    </div>
    {
      Object.keys(sortedPostsByYear)
        .sort((a, b) => b.localeCompare(a))
        .map((year) => (
          <section aria-label={year}>
            <h2>{year}</h2>
            {sortedPostsByYear[year].map((post) => {
              const coverUrl = getCoverUrl(post);
              const date = getPostDate(post);
              const excerpt = getPostExcerpt(post.body);
              const href = `/posts/zh/${getPostUrlSlug(post)}`;
              return (
                <article class="post-preview">
                  <h3 class="post-title">
                    <a class="!text-c !font-bold" href={href}>
                      {post.data.title}
                    </a>
                  </h3>
                  <time datetime={date} class="block text-sm opacity-50">
                    {formatDate(date, false)}
                  </time>
                  {coverUrl && (
                    <img
                      data-post-cover
                      class="post-cover"
                      src={coverUrl}
                      alt={post.data.title}
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                  {excerpt && <p class="post-excerpt">{excerpt}</p>}
                  <a
                    class="read-more"
                    href={href}
                    aria-label={`阅读全文：${post.data.title}`}
                  >
                    阅读全文
                  </a>
                  {post.data.tags && post.data.tags.length > 0 && (
                    <div class="post-tags" aria-label="文章标签">
                      {post.data.tags.map((tag) => (
                        <a href={`/posts/zh/tags/${slugifyTag(tag)}`} rel="tag">
                          #{tag}
                        </a>
                      ))}
                    </div>
                  )}
                </article>
              );
            })}
          </section>
        ))
    }
  </div>
</Layout>

<script>
  document.querySelectorAll<HTMLImageElement>("[data-post-cover]").forEach((image) => {
    const hideFailedCover = () => {
      image.hidden = true;
    };
    image.addEventListener("error", hideFailedCover, { once: true });
    if (image.complete && image.naturalWidth === 0) hideFailedCover();
  });
</script>

<style>
  .post-preview {
    margin-bottom: 48px;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .post-preview .post-title {
    margin: 0 0 8px;
  }
  .post-preview .post-cover {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    margin: 24px 0 0;
  }
  .post-preview .post-cover[hidden] {
    display: none;
  }
  .post-preview .post-excerpt {
    margin: 24px 0;
  }
  .post-preview .read-more {
    display: inline-block;
    margin-top: 16px;
    text-decoration-line: underline;
  }
  .post-excerpt + .read-more {
    margin-top: 0;
  }
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 12px;
    font-size: 0.875rem;
  }
  .post-tags a {
    max-width: 100%;
    overflow-wrap: anywhere;
    opacity: 0.85;
  }
  .post-tags a:hover {
    opacity: 1;
  }
</style>
