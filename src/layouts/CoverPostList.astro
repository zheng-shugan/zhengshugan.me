---
import { SITE } from "@config";
import Layout from "@layouts/Layout.astro";
import {
  formatDate,
  getPostDate,
  getPosts,
  getPostUrlSlug,
  getSortedPostsByYear,
  getTags,
  slugifyTag
} from "@utils";
import { getCoverUrl } from "@utils/cover";

const posts = await getPosts("zh");
const sortedPostsByYear = getSortedPostsByYear(posts);
const { tags, numPostsPerTag } = getTags(posts);
---

<Layout title={`博客 - ${SITE.title}`} activePage="posts">
  <div class="prose prose-lg m-auto">
    <h1>博客</h1>
    <a href="/posts/zh">归档列表</a>
    <div class="mt-4">
      {
        tags.map((tag) => (
          <span class="mr-1.5">
            <a href={`/posts/zh/tags/${slugifyTag(tag)}`} class="!text-c-light">
              {tag}
            </a>
            <sup>{numPostsPerTag[tag]}</sup>
          </span>
        ))
      }
    </div>
    {
      Object.keys(sortedPostsByYear)
        .sort((a, b) => b.localeCompare(a))
        .map((year) => (
          <section aria-label={year}>
            <h2>{year}</h2>
            {sortedPostsByYear[year].map((post) => {
              const coverUrl = getCoverUrl(post);
              const date = getPostDate(post);
              return (
                <a class="post-row !text-c" href={`/posts/zh/${getPostUrlSlug(post)}`}>
                  <div class="post-text">
                    <time datetime={date} class="text-sm opacity-50">
                      {formatDate(date, false)}
                    </time>
                    <div class="font-normal">{post.data.title}</div>
                  </div>
                  {coverUrl && (
                    <img
                      data-post-cover
                      class="post-cover"
                      src={coverUrl}
                      alt={post.data.cover?.alt ?? ""}
                      width="160"
                      height="90"
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                </a>
              );
            })}
          </section>
        ))
    }
  </div>
</Layout>

<script>
  document.querySelectorAll<HTMLImageElement>("[data-post-cover]").forEach((image) => {
    const hideFailedCover = () => {
      image.hidden = true;
    };
    image.addEventListener("error", hideFailedCover, { once: true });
    if (image.complete && image.naturalWidth === 0) hideFailedCover();
  });
</script>

<style>
  .post-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 0;
    text-decoration: none;
  }
  .post-text {
    flex: 1;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .post-row:hover .post-text > div {
    text-decoration: underline;
  }
  .post-row .post-cover {
    width: 96px;
    height: 54px;
    flex-shrink: 0;
    object-fit: cover;
    object-position: center;
    border-radius: 0.375rem;
    margin: 0;
  }
  .post-cover[hidden] {
    display: none;
  }
  @media (min-width: 640px) {
    .post-row .post-cover {
      width: 160px;
      height: 90px;
    }
  }
</style>
